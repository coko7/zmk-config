#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &five_col_layout; };
};

/ {
    combos {
        compatible = "zmk,combos";

        rt_jk_esc {
            bindings = <&kp ESC>;
            key-positions = <21 20>;
        };

        en_esc {
            bindings = <&kp ESC>;
            key-positions = <14 15>;
        };
    };

    behaviors {
        modmorph_minus_qmark: modmorph_minus_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "MODMORPH_MINUS_QMARK";
            bindings = <&kp MINUS>, <&kp QMARK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        modmorph_dot_colon: modmorph_dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "MODMORPH_DOT_COLON";
            bindings = <&kp DOT>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        modmorph_coma_semi: modmorph_coma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "MODMORPH_COMA_SEMI";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "ERGOL";

            // ------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
  &lt 3 Q           &kp C           &kp O                  &kp P          &kp W      &none  &none  &kp J                &kp M                     &kp D  &kp RIGHT_ALT        &kp Y
  &kp A             &kp S           &kp E                  &kp N          &kp F      &none  &none  &kp L                &kp R                     &kp T  &kp I                &kp U
  &mt LEFT_SHIFT Z  &mt LEFT_ALT X  &modmorph_minus_qmark  &kp V          &kp B                    &modmorph_dot_colon  &kp H                     &kp G  &modmorph_coma_semi  &kp K
                                    &kp LGUI               &mt LCTRL TAB  &kp SPACE                &lt 1 ENTER          &mt LEFT_SHIFT BACKSPACE  &mo 2
            >;
        };

        navnum_layer {
            display-name = "NAVNUM";

            // --------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  |
            // | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |
            // | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
  &kp N1   &kp N2          &kp N3            &kp N4           &kp N5           &trans  &trans  &kp N6    &kp N7     &kp N8     &kp N9     &kp N0
  &kp F14  &kp C_VOL_DN    &kp C_MUTE        &kp C_VOLUME_UP  &none            &trans  &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp DEL
  &kp F13  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT       &kp PRINTSCREEN                  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none
                           &trans            &trans           &mo 4                            &trans    &trans     &trans
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
  &kp LS(CARET)  &kp LS(LT)    &kp LS(GT)    &kp LS(DLLR)   &kp LS(PRCNT)  &trans  &trans  &kp LS(AT)    &kp LS(AMPS)  &kp LS(STAR)  &kp SQT        &kp GRAVE
  &kp LS(LBRC)   &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(RBRC)   &kp EQUAL      &trans  &trans  &kp BSLH      &kp KP_PLUS   &kp KP_MINUS  &kp FSLH       &kp LS(DQT)
  &kp LS(TILDE)  &kp LBKT      &kp RBKT      &kp LS(UNDER)  &kp LS(POUND)                  &kp LS(PIPE)  &kp LS(EXCL)  &kp SEMI      &kp LS(COLON)  &kp LS(QMARK)
                               &trans        &trans         &trans                         &trans        &trans        &trans
            >;
        };

        mouse_fn_layer {
            bindings = <
  &kp F1    &kp F2    &kp F3     &kp F4      &kp F5  &trans  &trans  &kp F6          &kp F7          &kp F8        &kp F9           &kp F10
  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp F11
  &trans    &trans    &trans     &trans      &trans                  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp F12
                      &trans     &trans      &trans                  &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;

            label = "MUSFN";
        };

        config_layer {
            display-name = "CONFIG";
            bindings = <
  &kp LS(LA(LC(LG(W))))  &trans  &trans                     &trans  &trans  &trans  &trans  &rgb_ug RGB_BRD  &rgb_ug RGB_EFR  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI
  &trans                 &trans  &kp LC(LA(Z))              &trans  &trans  &trans  &trans  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR
  &trans                 &trans  &kp LC(LG(LA(LS(SPACE))))  &trans  &trans                  &trans           &trans           &sys_reset       &bootloader      &studio_unlock
                                 &trans                     &trans  &trans                  &trans           &trans           &trans
            >;
        };
    };
};
