#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &five_col_layout; };
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        modmorph_minus_qmark: modmorph_minus_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "MODMORPH_MINUS_QMARK";
            bindings = <&kp MINUS>, <&kp QMARK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        modmorph_dot_colon: modmorph_dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "MODMORPH_DOT_COLON";
            bindings = <&kp DOT>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        modmorph_coma_semi: modmorph_coma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "MODMORPH_COMA_SEMI";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "ERGOL";

            // ------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
  &kp Q           &kp C           &kp O                  &kp P             &kp W      &none  &none  &kp J                &kp M              &kp D                &kp RIGHT_ALT        &kp Y
  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_CONTROL E     &mt LEFT_SHIFT N  &kp F      &none  &none  &kp L                &mt RIGHT_SHIFT R  &mt RIGHT_CONTROL T  &mt LEFT_ALT I       &mt RIGHT_GUI U
  &kp Z           &kp X           &modmorph_minus_qmark  &kp V             &kp B                    &modmorph_dot_colon  &kp H              &kp G                &modmorph_coma_semi  &kp K
                                  &lt 5 ESCAPE           &lt 1 SPACE       &lt 3 TAB                &lt 6 ENTER          &lt 7 BACKSPACE    &lt 2 DELETE
            >;
        };

        nav_layer {
            display-name = "NAVNUM";

            // --------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  |
            // | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |
            // | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
  &trans    &trans    &trans     &trans     &trans  &trans  &trans  &kp K_REDO    &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO
  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &trans  &kp CAPSLOCK  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
  &trans    &trans    &trans     &trans     &trans                  &kp INSERT    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END
                      &trans     &trans     &trans                  &kp ENTER     &kp BACKSPACE   &kp DELETE
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
  &kp LS(CARET)  &kp LS(LT)    &kp LS(GT)    &kp LS(DLLR)   &kp LS(PRCNT)  &trans  &trans  &kp LS(AT)    &kp LS(AMPS)  &kp LS(STAR)  &kp SQT        &kp GRAVE
  &kp LS(LBRC)   &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(RBRC)   &kp EQUAL      &trans  &trans  &kp BSLH      &kp KP_PLUS   &kp KP_MINUS  &kp FSLH       &kp LS(DQT)
  &kp LS(TILDE)  &kp LBKT      &kp RBKT      &kp LS(UNDER)  &kp LS(POUND)                  &kp LS(PIPE)  &kp LS(EXCL)  &kp SEMI      &kp LS(COLON)  &kp LS(QMARK)
                               &trans        &trans         &trans                         &trans        &trans        &trans
            >;
        };

        mouse_layer {
            bindings = <
  &trans    &trans    &trans     &trans      &trans  &trans  &trans  &kp K_REDO  &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO
  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &trans  &trans  &trans  &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
  &trans    &trans    &trans     &trans      &trans                  &trans      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT
                      &trans     &trans      &trans                  &mkp LCLK   &mkp RCLK       &mkp MCLK
            >;

            label = "MUSFN";
        };

        config_layer {
            display-name = "CONFIG";
            bindings = <
  &kp LS(LA(LC(LG(W))))  &trans  &trans                     &trans  &trans  &trans  &trans  &rgb_ug RGB_BRD  &rgb_ug RGB_EFR  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI
  &trans                 &trans  &kp LC(LA(Z))              &trans  &trans  &trans  &trans  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR
  &trans                 &trans  &kp LC(LG(LA(LS(SPACE))))  &trans  &trans                  &trans           &trans           &sys_reset       &bootloader      &studio_unlock
                                 &trans                     &trans  &trans                  &trans           &trans           &trans
            >;
        };

        media_layer {
            bindings = <
  &trans    &trans    &trans     &trans     &trans  &trans  &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF   &rgb_ug RGB_HUI    &rgb_ug RGB_SAI  &rgb_ug RGB_BRI
  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &trans  &trans           &kp C_PREVIOUS    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT
  &trans    &trans    &trans     &trans     &trans                  &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4
                      &trans     &trans     &trans                  &kp C_STOP       &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };

        num_layer {
            bindings = <
  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans  &trans  &trans  &trans     &trans     &trans    &trans
  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans  &trans  &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
  &trans  &kp N1  &kp N2  &kp N3  &trans                  &trans  &trans     &trans     &trans    &trans
                  &trans  &kp N0  &trans                  &trans  &trans     &trans
            >;
        };

        fun_layer {
            bindings = <
  &kp F12  &kp F7  &kp F8             &kp F9     &kp PRINTSCREEN  &trans  &trans  &trans  &trans     &trans     &trans    &trans
  &kp F11  &kp F4  &kp F5             &kp F6     &kp SCROLLLOCK   &trans  &trans  &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
  &kp F10  &kp F1  &kp F2             &kp F3     &kp PAUSE_BREAK                  &trans  &trans     &trans     &trans    &trans
                   &kp K_APPLICATION  &kp SPACE  &kp TAB                          &trans  &trans     &trans
            >;
        };
    };
};
